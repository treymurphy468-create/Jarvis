# Jarvis Mark 1 — required
OPENAI_API_KEY=sk-proj-...

# Credit balance bar (required for sk-proj keys — billing API is blocked on project keys)
# Match the credit balance on Billing → Overview (Pay as you go number)
# https://platform.openai.com/settings/organization/billing/overview
JARVIS_CREDIT_BALANCE=17.93

# Optional — user/org API key (sk-...) for automatic billing sync instead of manual balance
# OPENAI_BILLING_API_KEY=sk-...

# Optional — organization id (auto-detected from API responses if omitted)
# OPENAI_ORG_ID=org-...

# Optional — admin key for org costs API fallback (needs JARVIS_CREDIT_BALANCE as budget baseline)
# OPENAI_ADMIN_API_KEY=sk-admin-...

# Optional
# PORT=3847
# JARVIS_CREDIT_BAR_MAX=500
# JARVIS_RPM_LIMIT=60
# EXA_API_KEY=
