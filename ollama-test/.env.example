# Jarvis Ollama Test — environment variables
PORT=3848

# Ollama (local LLM)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_VOICE_MODEL=qwen3.5:2b
# OLLAMA_VOICE_NUM_PREDICT=64

# Local speech-to-text — tiny = fast, base = more accurate
STT_MODEL=Xenova/whisper-tiny.en
# STT_MODEL=Xenova/whisper-base.en

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_flash_v2_5

# Optional — image gen + screen vision
# OPENAI_API_KEY=

# Optional — inline web search
# EXA_API_KEY=
