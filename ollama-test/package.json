{
  "name": "jarvis-ollama-test",
  "version": "1.0.0",
  "description": "Jarvis test build — Ollama LLM + ElevenLabs voice",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm run server\" \"npm run vite\" \"wait-on http://localhost:5174 && npm run electron\"",
    "vite": "vite",
    "server": "node server/index.js",
    "electron": "electron .",
    "build": "vite build",
    "start": "concurrently -k \"npm run server\" \"npm run electron:prod\"",
    "electron:prod": "electron ."
  },
  "dependencies": {
    "sql.js": "^1.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mermaid": "^11.6.0",
    "openai": "^4.86.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "screenshot-desktop": "^1.15.1",
    "uuid": "^11.1.0",
    "ws": "^8.18.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "vite": "^6.2.0",
    "wait-on": "^8.0.3"
  }
}
