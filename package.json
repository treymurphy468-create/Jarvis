{
  "name": "jarvis-mark1",
  "version": "1.0.0",
  "description": "Jarvis — desktop AI companion with realtime voice and tools",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm run server\" \"npm run vite\" \"wait-on http-get://127.0.0.1:5173 http-get://127.0.0.1:3847/api/health && npm run electron\"",
    "test": "node --test src/config.test.js src/utils/*.test.js",
    "dev:ollama-test": "powershell -ExecutionPolicy Bypass -File scripts/run-ollama-test.ps1",
    "backup": "powershell -ExecutionPolicy Bypass -File scripts/backup-realtime.ps1",
    "backup:ollama-test": "powershell -ExecutionPolicy Bypass -File scripts/backup-ollama-test.ps1",
    "setup:ollama-test": "powershell -ExecutionPolicy Bypass -File scripts/setup-ollama-test.ps1",
    "vite": "vite",
    "server": "node server/index.js",
    "electron": "electron .",
    "build": "vite build",
    "desktop-shortcut": "powershell -ExecutionPolicy Bypass -File scripts/create-desktop-shortcut.ps1",
    "start": "concurrently -k \"npm run server\" \"wait-on http-get://127.0.0.1:3847/api/health && npm run electron:prod\"",
    "electron:prod": "electron ."
  },
  "dependencies": {
    "sql.js": "^1.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mermaid": "^11.6.0",
    "openai": "^4.86.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "screenshot-desktop": "^1.15.1",
    "uuid": "^11.1.0",
    "ws": "^8.18.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "vite": "^6.2.0",
    "wait-on": "^8.0.3"
  }
}
